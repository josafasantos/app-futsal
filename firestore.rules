rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Apenas os documentos da pelada são acessíveis
    match /peladas/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['dayActive', 'players', 'settings'])
                   && request.resource.data.settings.teamSize is number;
    }

    // Bloqueia qualquer outra rota ou coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
